# Local development only — copy to docker/.env (git-ignored) and replace every value.
# Use long random URL-safe values (letters, digits, '-' and '_'), e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# Never reuse these values anywhere else, and never put production secrets in a file.
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-value
DB_PASSWORD_MIGRATOR=replace-with-a-random-value
DB_PASSWORD_APP=replace-with-a-random-value
DB_PASSWORD_WORKER=replace-with-a-random-value
# Keys: 32 random bytes each in base64, all different, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# The local KEK exists only for development; production reads the KEK from 1Password Connect (ADR-0013).
LOCAL_KEK=replace-with-32-random-bytes-in-base64
BLIND_INDEX_KEY=replace-with-32-random-bytes-in-base64
RATE_LIMIT_KEY=replace-with-32-random-bytes-in-base64
# Host port for the API (bound to 127.0.0.1 only).
API_PORT=3000
# Mail catcher (Mailpit, local development only): the SMTP password between the worker and Mailpit — a random
# value as above — and the host port of its web UI and API (bound to 127.0.0.1 only).
MAIL_CATCHER_PASSWORD=replace-with-a-random-value
MAIL_UI_PORT=8025
# Optional: where the links in emails point (`<base>/verify-email#token=…`); https://questline.test by default.
# PUBLIC_LINK_BASE_URL=https://questline.test
