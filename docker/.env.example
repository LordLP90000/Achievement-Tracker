# Local development only — copy to docker/.env (git-ignored) and replace every value.
# Use long random URL-safe values (letters, digits, '-' and '_'), e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# Never reuse these values anywhere else, and never put production secrets in a file.
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-value
DB_PASSWORD_MIGRATOR=replace-with-a-random-value
DB_PASSWORD_APP=replace-with-a-random-value
DB_PASSWORD_WORKER=replace-with-a-random-value
# Host port for the API (bound to 127.0.0.1 only).
API_PORT=3000
