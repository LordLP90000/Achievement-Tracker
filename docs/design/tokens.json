    "headline": { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 17, "lineHeight": 23, "fontWeight": 600, "letterSpacing": "-0.026em" }, "$extensions": { "ios": ".headline", "android": "titleMedium" } },
