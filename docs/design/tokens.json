    "pill": { "$value": "999px", "$description": "Buttons, chips, bars" }
  },
  "size": {
    "$type": "dimension",
    "touch-min": { "$value": "48px", "$description": "Minimum hit area on both platforms (iOS 44 pt, Android 48 dp): 48 meets both." },
    "button-lg": { "$value": "56px" },
    "button-md": { "$value": "48px" },
    "check": { "$value": "44px", "$description": "One-tap check-in circle; hit area extends to 48." },
    "icon-sm": { "$value": "16px" },
    "icon-md": { "$value": "20px" },
    "icon-lg": { "$value": "24px" },
    "tab-bar": { "$value": "62px", "$description": "iOS: floating Liquid Glass capsule, 16 pt from the sides, resting above the home indicator. Android: 80 dp Material 3 navigation bar plus the gesture area." },
    "fab": { "$value": "56px", "$description": "Android extended FAB height (“New achievement”), 16 dp above the navigation bar and from the edge." }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms", "$description": "Press feedback" },
