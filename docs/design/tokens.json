      "base": { "$value": "200ms", "$description": "State changes" },
      "medium": { "$value": "280ms", "$description": "Sheets, expanding sections" },
      "slow": { "$value": "400ms", "$description": "Screen transitions, ring fill" },
      "celebrate": { "$value": "900ms", "$description": "Badge reveal, confetti (full motion only)" },
      "reduced": { "$value": "150ms", "$description": "Every animation under Reduce Motion becomes an opacity fade of this length" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0, 1] },
      "exit": { "$value": [0.3, 0, 1, 1] }
    },
    "spring": {
      "$description": "Quest-complete pop only — never on a plain check-in. iOS: spring(response 0.35, dampingFraction 0.75). Android: spring(dampingRatio 0.75, stiffness 500).",
      "check": { "$value": { "response": 0.35, "dampingFraction": 0.75 } }
    }
  },
  "$extensions": {
    "ql.contrast": {
      "$description": "Pairs checked by tools/tokens.mjs in both themes: text 4.5:1, non-text UI 3:1 (WCAG 2.2 SC 1.4.3, 1.4.11). With Increase Contrast (theme.*-contrast) the same pairs must reach 7:1 and 4.5:1 (HIG color.md: “significantly higher” differentiation).",
      "text": [
        ["text.primary", "bg.canvas"],
        ["text.primary", "bg.surface"],
        ["text.primary", "bg.muted"],
        ["text.secondary", "bg.canvas"],
        ["text.secondary", "bg.surface"],
        ["text.secondary", "bg.muted"],
        ["text.tertiary", "bg.canvas"],
        ["text.tertiary", "bg.surface"],
        ["text.tertiary", "bg.muted"],
        ["text.accent", "bg.canvas"],
        ["text.accent", "bg.surface"],
        ["text.accent", "state.active-container"],
        ["text.on-primary", "action.primary"],
        ["text.on-primary", "action.primary-pressed"],
        ["action.on-secondary", "action.secondary"],
        ["action.on-secondary", "action.secondary-pressed"],
        ["text.inverse", "bg.inverse"],
        ["action.inverse-accent", "bg.inverse"],
        ["state.active-fg", "state.active-container"],
        ["state.on-active-solid", "state.active-solid"],
        ["state.done-fg", "bg.surface"],
        ["state.done-fg", "state.done-container"],
        ["state.on-done-solid", "state.done-solid"],
        ["state.bonus-fg", "bg.surface"],
        ["state.bonus-fg", "state.bonus-container"],
        ["state.on-bonus-solid", "state.bonus-solid"],
        ["state.locked-fg", "bg.surface"],
        ["state.locked-fg", "state.locked-container"],
        ["state.paused-fg", "bg.surface"],
        ["state.paused-fg", "state.paused-container"],
        ["state.danger-fg", "bg.surface"],
        ["state.danger-fg", "state.danger-container"],
        ["state.on-danger-solid", "state.danger-solid"]
      ],
      "ui": [
        ["border.strong", "bg.surface"],
        ["border.strong", "bg.canvas"],
        ["progress.fill", "progress.track"],
        ["progress.fill", "bg.surface"],
        ["focus.ring", "bg.surface"],
        ["focus.ring", "bg.canvas"],
        ["state.missed-border", "bg.surface"],
