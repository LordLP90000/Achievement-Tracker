    "$type": "dimension",
    "sm": { "$value": "8px", "$description": "Tags, small chips inside cards" },
    "md": { "$value": "12px", "$description": "Inputs, tiles" },
    "lg": { "$value": "16px", "$description": "Inner cards, list groups" },
    "xl": { "$value": "24px", "$description": "Cards" },
