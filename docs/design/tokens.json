  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": "Fraunces, 'Iowan Old Style', Georgia, serif", "$description": "Brand moments only (HIG branding.md: custom font for headlines, system font for body copy and captions): onboarding headlines, the achievement title in its detail header, level numbers, celebrations, badges and the share card. Bundled (OFL). Axes SOFT 100, WONK 0, optical size automatic. Must follow Dynamic Type (iOS: Font.custom(_:size:relativeTo:); Android: sp) and Bold Text (+100 weight; iOS legibilityWeight == .bold, Android fontWeightAdjustment)." },
      "text": { "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro', 'Inter Variable', Inter, system-ui, sans-serif", "$description": "All UI text on iOS: the system font (SF Pro) through the built-in text styles, so Dynamic Type, Bold Text and tracking come for free. Never bundled. Previews fall back to Inter (OFL) where SF Pro isn't available. Numbers that change use tabular figures." },
      "text-android": { "$value": "Roboto, 'Roboto Variable', system-ui, sans-serif", "$description": "All UI text on Android: the device's system font (Roboto on most phones) through MaterialTheme.typography. Previews bundle Roboto (OFL). Tracking 0 except uppercase labels." }
    }
  },
  "type": {
    "$description": "Sizes in pt (iOS) / sp (Android) at the default text size. All scale with Dynamic Type / font scale up to 200 %; ios / android name the platform text style each maps to. Tracking is SF Pro's at that size (HIG typography.md › Tracking values) — on a device the system applies it; mock-ups need it set by hand. Android frames use 0.",
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": 40, "lineHeight": 46, "fontWeight": 600, "letterSpacing": "-0.01em" }, "$extensions": { "ios": "Fraunces, relativeTo .largeTitle", "android": "displaySmall (Fraunces)", "use": "Level-up number" } },
    "brand-large": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": 34, "lineHeight": 40, "fontWeight": 600, "letterSpacing": "-0.01em" }, "$extensions": { "ios": "Fraunces, relativeTo .largeTitle", "android": "headlineLarge (Fraunces)", "use": "Onboarding headlines, unlocked achievement" } },
    "brand-title": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": 28, "lineHeight": 34, "fontWeight": 600, "letterSpacing": "-0.005em" }, "$extensions": { "ios": "Fraunces, relativeTo .title", "android": "headlineMedium (Fraunces)", "use": "Achievement title in its detail header" } },
    "large-title": { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 34, "lineHeight": 41, "fontWeight": 700, "letterSpacing": "0.012em" }, "$extensions": { "ios": ".largeTitle (bold)", "android": "headlineLarge" } },
    "title-1": { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 28, "lineHeight": 34, "fontWeight": 700, "letterSpacing": "0.014em" }, "$extensions": { "ios": ".title (bold)", "android": "headlineMedium" } },
    "title-2": { "$type": "typography", "$value": { "fontFamily": "{font.family.text}", "fontSize": 22, "lineHeight": 28, "fontWeight": 700, "letterSpacing": "-0.012em" }, "$extensions": { "ios": ".title2 (bold)", "android": "titleLarge" } },
